# Salin file ini jadi .env lalu isi nilainya.
# .env TIDAK ikut ke-commit (lihat .gitignore).
# Untuk GitHub Actions, isi lewat Settings > Secrets and variables > Actions:
#   TELEGRAM_BOT_TOKEN = token bot dari @BotFather
#   TELEGRAM_CHAT_ID   = ID numerik channel, mis. -1001234567890

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001234567890